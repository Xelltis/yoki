{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push *)"
    ],
    "allow": [
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx oxlint *)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run test:coverage)",
      "Bash(npm run typecheck)",
      "Bash(npm ls *)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "yomiyasu@yomiyasu": true
  },
  "extraKnownMarketplaces": {
    "yomiyasu": {
      "source": {
        "source": "github",
        "repo": "nanaism/yomiyasu"
      }
    }
  }
}
