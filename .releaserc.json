{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "足したこと・変えたこと" },
            { "type": "fix", "section": "直したこと" },
            { "type": "perf", "section": "速くしたこと" },
            { "type": "revert", "section": "取り消したこと" },
            { "type": "docs", "hidden": true },
            { "type": "style", "hidden": true },
            { "type": "refactor", "hidden": true },
            { "type": "test", "hidden": true },
            { "type": "build", "hidden": true },
            { "type": "ci", "hidden": true },
            { "type": "chore", "hidden": true }
          ]
        }
      }
    ],
    "./tools/release/commit-version.mjs",
    ["@semantic-release/github", { "successComment": false, "failComment": false, "releasedLabels": false }]
  ]
}
