// 卓予定（Yoki）の Worker の設定。npm run dev と npm run build（Vite）がこれを読む。
// 公開する Cloudflare ごとに違う値（D1 の ID・APP_URL・DISCORD_CLIENT_ID）は、ここには仮の値だけを置く。
// 公開のときに GitHub Actions（.github/workflows/deploy.yml）が、environment「production」の値を組み立てた設定に入れる（vite.config.ts）
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yoki",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    // 画面（src/client を Vite で組み立てたもの）。次の道は Worker が先に受ける（ログインの確認やデータのため）。
    // /admin（運営者の管理画面）も、運営者かを確かめてから返すので、ここに入れる（入れないと、確かめずに配ってしまう）。
    // /terms・/privacy（利用規約・プライバシーポリシー）は、運営者が直した本文を D1 から読んで返す
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/g/*", "/dev/*", "/admin", "/admin/*", "/terms", "/privacy"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yoki",
      // 仮の ID（手元の D1 はこのままでよい）。本番の ID は、公開のときに YOKI_D1_DATABASE_ID から入れる
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "triggers": {
    // 知らせの見回り（5 分おき。時刻は UTC だが、中で日本時間に直して判断する）
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    // Discord の文に付けるアプリの URL と、Discord アプリのクライアント ID。手元では .dev.vars で、本番では公開のときに入れる。
    // 秘密の値（DISCORD_CLIENT_SECRET・DISCORD_BOT_TOKEN）と運営者の ID（OPERATOR_IDS）は vars に置かず、Worker の secret にする（src/worker/env.ts）
    "APP_URL": "",
    "DISCORD_CLIENT_ID": ""
  },
  "observability": { "enabled": true }
}
