// 卓予定（Yoki）のWorkerの設定。npm run devとnpm run build（Vite）がこれを読む。
// 公開するCloudflareごとに違う値（D1のID・APP_URL・DISCORD_CLIENT_ID）は、ここには仮の値だけを置く。
// 公開のときにGitHub Actions（.github/workflows/deploy.yml）が、environment「production」の値を組み立てた設定に入れる（vite.config.ts）
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yoki",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    // 画面（src/clientをViteで組み立てたもの）。次の道はWorkerが先に受ける（ログインの確認やデータのため）。
    // /admin（運営者の管理画面）も、運営者かを確かめてから返すので、ここに入れる（入れないと、確かめずに配ってしまう）。
    // /terms・/privacy（利用規約・プライバシーポリシー）は、運営者が直した本文をD1から読んで返す
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/g/*", "/dev/*", "/admin", "/admin/*", "/terms", "/privacy", "/cal/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yoki",
      // 仮のID（手元のD1はこのままでよい）。本番のIDは、公開のときにYOKI_D1_DATABASE_IDから入れる
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "triggers": {
    // 知らせの見回り（5分おき。時刻はUTCだが、中で日本時間に直して判断する）
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    // Discordの文に付けるアプリのURLと、DiscordアプリのクライアントID。手元では .dev.varsで、本番では公開のときに入れる。
    // 秘密の値（DISCORD_CLIENT_SECRET・DISCORD_BOT_TOKEN）と運営者のID（OPERATOR_IDS）はvarsに置かず、Workerのsecretにする（src/worker/env.ts）
    "APP_URL": "",
    "DISCORD_CLIENT_ID": "",
    "GOOGLE_CLIENT_ID": "",
    // 公開しているリポジトリ（owner/name）と、新しい版を見に行く元のリポジトリ。公開のときに入れる（運営の管理画面の「更新」）
    "APP_REPOSITORY": "",
    "UPSTREAM_REPOSITORY": ""
  },
  "observability": { "enabled": true }
}
