// 卓予定（Yoki）のWorkerの設定。npm run devとnpm run build（Vite）がこれを読む。
// 公開するCloudflareごとに違う値は、ここには仮の値だけを置くか、書かない。
//   D1のID: 仮の値。公開のときにGitHub Actions（.github/workflows/deploy.yml）が、組み立てた設定にYOKI_D1_DATABASE_IDから入れる（vite.config.ts）
//   DiscordアプリのIDや公開のアドレスなど: Workerのsecretに置く（src/worker/env.ts）。varsにしない
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yoki",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    // 画面（src/clientをViteで組み立てたもの）。次の道はWorkerが先に受ける（ログインの確認やデータのため）。
    // /（入口）は、リンクを貼ったときの見た目（OGP）に公開のアドレスを入れて返す（routes/pages.ts）。
    // /admin（運営者の管理画面）も、運営者かを確かめてから返すので、ここに入れる（入れないと、確かめずに配ってしまう）。
    // /terms・/privacy（利用規約・プライバシーポリシー）は、運営者が直した本文をD1から読んで返す
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/auth/*", "/g/*", "/dev/*", "/admin", "/admin/*", "/terms", "/privacy", "/cal/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yoki",
      // 仮のID（手元のD1はこのままでよい）。本番のIDは、公開のときにYOKI_D1_DATABASE_IDから入れる
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "triggers": {
    // 知らせの見回り（5分おき。時刻はUTCだが、中で日本時間に直して判断する）
    "crons": ["*/5 * * * *"]
  },
  "observability": { "enabled": true }
}
